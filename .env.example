# ==============================================================================
# Personal Assistant AI — Root Environment Configuration Template (.env.example)
# Copia este archivo como '.env' en la raíz y configura tus credenciales.
# NUNCA subas el archivo '.env' con valores reales a Git.
# ==============================================================================

# --- Entorno y Servidor Backend ---
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# --- Seguridad y Autenticación ---
# Token para proteger endpoints sensibles (/chat, /voice, /tts, /db/status)
# Si se deja vacío, el backend opera en modo desarrollo permisivo.
# Para producción o red remota, genera un token aleatorio seguro: openssl rand -hex 32
API_BEARER_TOKEN=tu_bearer_token_seguro_aqui

# Secret para autenticar webhooks bancarios (/webhooks/bank)
# Enviado en el header HTTP 'X-Webhook-Secret' por MacroDroid o automatizaciones.
BANK_WEBHOOK_SECRET=tu_webhook_secret_bancario_aqui

# --- CORS ---
CORS_ORIGINS=["*"]

# --- Proveedores LLM ---
# Opciones: "dual" (failover simultáneo Google + Ollama) | "google" | "ollama" | "mock"
LLM_PROVIDER=dual
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=25.0

# --- Google AI Studio (Gemini Cloud LLM) ---
GEMINI_API_KEY=tu_api_key_de_google_ai_studio_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=25.0

# --- Speech To Text (Whisper) ---
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Base de Datos PostgreSQL / Supabase ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_service_role_o_anon_key_aqui
DATABASE_URL=postgresql://postgres:tu_password@db.tu-proyecto.supabase.co:5432/postgres

# --- Correo Electrónico IMAP / SMTP (Fase 12) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=tu_correo@gmail.com
IMAP_PASSWORD=tu_contraseña_de_aplicacion
IMAP_USE_SSL=True

# --- Variables Públicas para Cliente Móvil (Expo / React Native) ---
EXPO_PUBLIC_BACKEND_URL=http://192.168.40.15:8000
EXPO_PUBLIC_TAILSCALE_IP=100.95.54.56
EXPO_PUBLIC_API_TOKEN=tu_bearer_token_seguro_aqui
EXPO_PUBLIC_BANK_WEBHOOK_SECRET=tu_webhook_secret_bancario_aqui
