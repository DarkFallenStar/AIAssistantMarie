# ==============================================================================
# Backend Environment Configuration Template (backend/.env.example)
# ==============================================================================

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Seguridad y Autenticación
API_BEARER_TOKEN=tu_bearer_token_seguro_aqui
BANK_WEBHOOK_SECRET=tu_webhook_secret_bancario_aqui

# CORS
CORS_ORIGINS=["*"]

# LLM Providers: "dual" | "google" | "ollama" | "mock"
LLM_PROVIDER=dual
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=25.0

# Google AI Studio (Gemini)
GEMINI_API_KEY=tu_api_key_de_google_ai_studio_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=25.0

# Speech To Text (Whisper)
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Supabase / PostgreSQL Database
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_service_role_o_anon_key_aqui
DATABASE_URL=postgresql://postgres:tu_password@db.tu-proyecto.supabase.co:5432/postgres

# Correo Electrónico IMAP / SMTP
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=tu_correo@gmail.com
IMAP_PASSWORD=tu_contraseña_de_aplicacion
IMAP_USE_SSL=True
